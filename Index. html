<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculator by Meta AI</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}
  body{background:#0f0f0f;display:flex;justify-content:center;align-items:center;min-height:100vh}
  .calc{background:#1a1a1a;width:320px;border-radius:24px;padding:20px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
  .display{background:#000;color:#fff;text-align:right;padding:20px;border-radius:16px;margin-bottom:16px;min-height:80px;word-wrap:break-word;overflow:hidden}
  #prev{color:#888;font-size:14px;min-height:18px}
  #curr{font-size:36px;font-weight:600;margin-top:4px}
  .btns{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  button{border:none;height:64px;border-radius:16px;font-size:20px;font-weight:600;cursor:pointer;transition:.15s}
  button:active{transform:scale(.92)}
  .num{background:#2a2a2a;color:#fff}
  .num:hover{background:#333}
  .op{background:#ff9f0a;color:#fff}
  .op:hover{background:#ffb143}
  .func{background:#a5a5a5;color:#000}
  .zero{grid-column:span 2}
</style>
</head>
<body>
<div class="calc">
  <div class="display">
    <div id="prev"></div>
    <div id="curr">0</div>
  </div>
  <div class="btns">
    <button class="func" onclick="clearAll()">AC</button>
    <button class="func" onclick="del()">⌫</button>
    <button class="func" onclick="append('%')">%</button>
    <button class="op" onclick="append('/')">÷</button>
    <button class="num" onclick="append('7')">7</button>
    <button class="num" onclick="append('8')">8</button>
    <button class="num" onclick="append('9')">9</button>
    <button class="op" onclick="append('*')">×</button>
    <button class="num" onclick="append('4')">4</button>
    <button class="num" onclick="append('5')">5</button>
    <button class="num" onclick="append('6')">6</button>
    <button class="op" onclick="append('-')">−</button>
    <button class="num" onclick="append('1')">1</button>
    <button class="num" onclick="append('2')">2</button>
    <button class="num" onclick="append('3')">3</button>
    <button class="op" onclick="append('+')">+</button>
    <button class="num zero" onclick="append('0')">0</button>
    <button class="num" onclick="append('.')">.</button>
    <button class="op" onclick="calculate()">=</button>
  </div>
</div>
<script>
  let currEl = document.getElementById('curr');
  let prevEl = document.getElementById('prev');
  let expression = '';

  function update() {
    currEl.textContent = expression || '0';
    prevEl.textContent = expression;
  }

  function append(val) {
    if (expression === 'Error') expression = '';
    expression += val;
    update();
  }

  function clearAll() {
    expression = '';
    update();
  }

  function del() {
    expression = expression.slice(0, -1);
    update();
  }

  function calculate() {
    try {
      // safe eval
      let result = Function('"use strict";return (' + expression + ')')();
      if (!isFinite(result)) throw new Error();
      expression = String(Math.round(result * 100000000) / 100000000);
      update();
    } catch {
      expression = 'Error';
      update();
    }
  }
</script>
</body>
</html>
